# Kalshi API key (optional — market data is public; key only needed for trading)
# Get one at https://kalshi.com/account/api
KALSHI_API_KEY=

# The Odds API (optional — legacy; Kalshi/Polymarket are used instead)
ODDS_API_KEY=

# Ball Don't Lie API key (optional — improves NBA player prop data)
# Free tier at https://www.balldontlie.io/
BALLDONTLIE_KEY=

# Output directory for generated CSVs (default: ./output)
OUTPUT_DIR=./output

# Cache directory (default: ./.cache)
CACHE_DIR=./.cache

# Ratings storage (default: ./storage/ratings.json)
RATINGS_FILE=./storage/ratings.json

# How many recent games to weight heavily in rolling averages
PROP_LOOKBACK=15
